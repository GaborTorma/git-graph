<script>
let DATA = __DATA__;
/* Honnan él a lap: `static` — beágyazott pillanatkép (gg), `http` — a helyi
   gg --serve (Browser panel), `mcp` — Artifact, amely a Claude app host-hídján
   át a gépen futó `gg --mcp`-ből kéri az adatot (a SLUG repóét). */
const MODE = '__MODE__';
const SLUG = '__SLUG__';
const MCP_SERVER = 'host:git-graph';

// A Git Graph alap sáv-palettája: sávindex szerint ciklikusan.
const LANE_COLORS = ['#0085d9','#d9008f','#00d90a','#d9c000','#d90000',
                     '#4d00d9','#d94a00','#00d9cc','#e138e8','#85d900'];
const ROW_H = 24, LANE_W = 16, X0 = 12, DOT_R = 4;

const rowsEl = document.getElementById('rows');
const svg = document.getElementById('lanes');
const counter = document.getElementById('counter');
let expanded = null;      // a kinyitott commit sha-ja
let visible = DATA.commits; // szűrés utáni lista

let graphW = 72;

/* Minden, ami a DATA-ból származik és adatcserekor újraszámolandó. */
function hydrate() {
  const laneCount = DATA.commits.reduce((m, c) => Math.max(m, c.lane), 0) + 1;
  // Csak annyi, amennyit a sávok kérnek — a fejlécben ikon van, nem felirat.
  graphW = Math.max(28, X0 * 2 + (laneCount - 1) * LANE_W);
  document.documentElement.style.setProperty('--graph-w', graphW + 'px');
  document.getElementById('repoName').textContent = DATA.meta.repo;
  document.title = DATA.meta.repo + ' Git Graph';
  document.getElementById('headRef').textContent = DATA.meta.head
    ? DATA.meta.head + ' · ' + DATA.meta.totalCommits + ' commit' : '';
}

/* ── Gráf rajzolása ──────────────────────────────────────────────────────── */
function laneX(l) { return X0 + l * LANE_W; }

/* A sorok Y-pozíciója a DOM-ból jön, nem sorszám × magasság: kinyitott
   commit-panel esetén az alatta lévő sorok lejjebb csúsznak, és a pöttyöknek
   velük kell menniük — a panel mellett a vonal egyszerűen hosszabb lesz. */
function drawGraph() {
  const rowIndexBySha = new Map(visible.map((c, i) => [c.sha, i]));
  const tops = [...rowsEl.querySelectorAll('.row')].map(el => el.offsetTop);
  const rowY = i => (tops[i] ?? i * ROW_H) + ROW_H / 2;
  const h = Math.max(rowsEl.offsetHeight, visible.length * ROW_H);
  svg.setAttribute('width', graphW);
  svg.setAttribute('height', h);
  svg.setAttribute('viewBox', `0 0 ${graphW} ${h}`);

  let out = '';
  for (const e of DATA.edges) {
    const a = rowIndexBySha.get(DATA.commits[e.fromRow].sha);
    const b = rowIndexBySha.get(DATA.commits[e.toRow].sha);
    if (a === undefined || b === undefined) continue;   // szűrve
    const x1 = laneX(e.fromLane), y1 = rowY(a);
    const x2 = laneX(e.toLane),   y2 = rowY(b);
    const color = LANE_COLORS[(e.merge ? e.fromLane : e.toLane) % LANE_COLORS.length];
    // A munkakönyvtár még nem commit: szaggatva lóg a HEAD-re.
    const dash = DATA.commits[e.fromRow].uncommitted ? ' stroke-dasharray="3 3"' : '';
    out += `<path d="${edgePath(x1, y1, x2, y2, e.merge)}" fill="none" stroke="${color}" stroke-width="2"${dash}/>`;
  }
  visible.forEach((c, i) => {
    const color = LANE_COLORS[c.lane % LANE_COLORS.length];
    const merge = c.parents.length > 1;
    // Az ál-sor pontja üres karika: a szaggatott vonal már jelzi, hogy nem
    // commit — a pöttyözött körvonal ezen a méreten csak elmosódna.
    const hollow = merge || c.uncommitted;
    out += `<circle cx="${laneX(c.lane)}" cy="${rowY(i)}" r="${hollow ? DOT_R + 1 : DOT_R}"`
        +  ` fill="${hollow ? 'var(--bg)' : color}" stroke="${color}" stroke-width="2"/>`;
  });
  svg.innerHTML = out;
}

/* Sávváltásnál ott hajlik a vonal, ahol a git is: merge-nél rögtön a merge
   commit alatt, ág-leágazásnál pedig közvetlenül a szülő fölött. */
function edgePath(x1, y1, x2, y2, merge) {
  if (x1 === x2) return `M ${x1} ${y1} L ${x2} ${y2}`;
  if (merge) {
    const bend = Math.min(y1 + ROW_H, y2);
    return `M ${x1} ${y1} C ${x1} ${bend}, ${x2} ${y1}, ${x2} ${bend} L ${x2} ${y2}`;
  }
  const bend = Math.max(y2 - ROW_H, y1);
  return `M ${x1} ${y1} L ${x1} ${bend} C ${x1} ${y2}, ${x2} ${bend}, ${x2} ${y2}`;
}

/* ── Sorok ───────────────────────────────────────────────────────────────── */
const esc = s => String(s).replace(/[&<>"]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));
const pad = n => String(n).padStart(2, '0');
const fmtDate = iso => { const d = new Date(iso);
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())} `
       + `${pad(d.getHours())}:${pad(d.getMinutes())}`; };

/* GitHub-linkek: valódi `<a target="_blank">` — az Artifact keretéből a Claude
   app csak ezt engedi át (mérve: a `window.open` el sem jutott hozzá). Commit
   és fájl csak pusholt commitnál (`pushed`, a Python jelöli): a helyi a
   GitHubon 404 lenne. A fájl-diff horgonyát (`anchor`) is a Python számolja. */
const ghLink = (href, html) =>
  `<a class="gh-link" href="${href}" target="_blank" rel="noopener">${html}</a>`;

/* `#12` és `owner/repo#12` → issue/PR (a `/issues/N` a PR-ra átirányít).
   Előtte nem állhat szó- vagy URL-karakter: a `C#1` és a `lap.html#3` marad szöveg. */
const ISSUE_RE = /(^|[^\w.\/-])([\w.-]+\/[\w.-]+)?#(\d+)\b/g;
function linkify(s) {
  const text = esc(s), base = DATA.meta.repoUrl;
  if (!base) return text;
  return text.replace(ISSUE_RE, (m, pre, repo, n) =>
    pre + ghLink(`${repo ? 'https://github.com/' + repo : base}/issues/${n}`, `${repo || ''}#${n}`));
}
const commitUrl = c => `${DATA.meta.repoUrl}/commit/${c.sha}`;
const shaHtml = (c, text) => c.pushed ? ghLink(commitUrl(c), text) : text;
const pathHtml = (c, f) => c.pushed
  ? ghLink(commitUrl(c) + (f.anchor ? '#diff-' + f.anchor : ''), esc(f.path)) : esc(f.path);

/* A Browser panel a linket a saját fülén nyitná — ott a szerver nyitja a
   rendszerböngészőben. Máshol (Artifact, fájl) a link maga nyílik. */
document.addEventListener('click', e => {
  const a = e.target.closest('a.gh-link');
  if (!a || MODE !== 'http') return;
  e.preventDefault();
  fetch('/open?url=' + encodeURIComponent(a.href), { method: 'POST' })
    .then(r => { if (!r.ok) throw new Error(r.status); })
    .catch(() => window.open(a.href, '_blank', 'noopener'));
});

function badges(c) {
  return c.refs.map(r => {
    const label = r.kind === 'head' ? r.name : r.name;
    const title = r.kind === 'head' ? 'HEAD → ' + r.name : r.kind + ': ' + r.name;
    return `<span class="badge ref-${r.kind}" title="${esc(title)}"><span class="dot"></span>${esc(label)}</span>`;
  }).join('');
}

function render() {
  rowsEl.innerHTML = visible.map((c, i) => `
    <button class="row${c.uncommitted ? ' uncommitted' : ''}" type="button" data-sha="${c.sha}" aria-expanded="false">
      <span class="cell"></span>
      <span class="cell desc">${badges(c)}<span class="subject">${linkify(c.subject)}</span></span>
      <span class="cell date">${fmtDate(c.date)}</span>
      <span class="cell author">${esc(c.author)}</span>
      <span class="cell sha mono">${shaHtml(c, c.short)}</span>
    </button>`).join('') || '<p class="empty">Nincs a szűrésnek megfelelő commit.</p>';
  drawGraph();
  const shown = visible.filter(c => !c.uncommitted).length;   // az ál-sor nem commit
  counter.innerHTML = `<b>${shown}</b> commit látszik / ${DATA.meta.totalCommits}`;
  if (expanded && visible.some(c => c.sha === expanded)) open(expanded); else expanded = null;
}

/* ── Commit-részletek ────────────────────────────────────────────────────── */
function open(sha) {
  document.querySelectorAll('.details').forEach(d => d.remove());
  const row = rowsEl.querySelector(`.row[data-sha="${sha}"]`);
  if (!row) return;
  rowsEl.querySelectorAll('.row').forEach(r => r.setAttribute('aria-expanded', 'false'));
  row.setAttribute('aria-expanded', 'true');

  const c = DATA.commits.find(x => x.sha === sha);
  const st = DATA.stats[sha] || { files: [], add: 0, del: 0 };
  const parents = c.parents.length
    ? c.parents.map(p => `<a data-jump="${p}">${p.slice(0, 7)}</a>`).join(' · ')
    : '—';

  const el = document.createElement('div');
  el.className = 'details';
  el.innerHTML = `
    <h2>${linkify(c.subject)}</h2>
    <dl class="meta">
      <dt>Commit</dt><dd class="mono">${shaHtml(c, c.sha)}</dd>
      <dt>Szülő</dt><dd class="mono">${parents}</dd>
      <dt>Szerző</dt><dd>${esc(c.author)}</dd>
      <dt>Dátum</dt><dd>${fmtDate(c.date)}</dd>
    </dl>
    ${c.body ? `<p class="body-text">${linkify(c.body)}</p>` : ''}
    <div class="files">
      <div class="files-head">${st.files.length} fájl ·
        <span style="color:var(--add)">+${st.add}</span>
        <span style="color:var(--del)">−${st.del}</span></div>
      ${st.files.map(f => `<div class="file" data-path="${esc(f.path)}" aria-expanded="false">
        <span class="chev" aria-hidden="true">›</span>
        <span class="path mono">${pathHtml(c, f)}</span>
        <span class="churn mono">${f.new ? 'új' : f.bin ? 'bin'
          : `<span class="a">+${f.add}</span> <span class="d">−${f.del}</span>`}</span></div>
        <div class="diff" hidden></div>`).join('')}
    </div>`;
  row.after(el);
  expanded = sha;
  // Újrarajzolás (élő adatcsere) után a korábban lenyitott fájlok nyitva maradnak.
  el.querySelectorAll('.file').forEach(f => {
    if (openFiles.has(sha + '\n' + f.dataset.path)) toggleFile(f, sha, true);
  });
  drawGraph();               // a panel alatti sorok lejjebb kerültek
}

/* ── Fájl-diff ───────────────────────────────────────────────────────────────
   A diffet a lap lustán kéri, fájlonként (http: /diff, mcp: file_diff tool) —
   a teljes adatban nincs benne. A commitok diffje nem változik, gyorstárazzuk;
   az Uncommitted soré adatcserekor elavul (`stale`): a régi látszik, amíg az
   új meg nem jön, így a 2 mp-es frissítés nem villog. */
const openFiles = new Set();   // sha + '\n' + út
const diffCache = new Map();   // ugyanígy kulcsolva → { data, stale }
let SRC = null;                // az élő adatforrás (startLive állítja); statikusan nincs

function toggleFile(fileEl, sha, on) {
  const key = sha + '\n' + fileEl.dataset.path;
  const box = fileEl.nextElementSibling;
  fileEl.setAttribute('aria-expanded', on ? 'true' : 'false');
  box.hidden = !on;
  if (!on) { openFiles.delete(key); drawGraph(); return; }
  openFiles.add(key);

  const show = html => {
    if (!fileEl.isConnected || fileEl.getAttribute('aria-expanded') !== 'true') return;
    box.innerHTML = html;
    drawGraph();
  };
  const cached = diffCache.get(key);
  if (!SRC) return show('<p class="diff-note">A diff csak élő nézetben látszik '
    + '(Browser panel: gg --serve, vagy az Artifact a Claude appban).</p>');
  show(cached ? diffHtml(cached.data) : '<p class="diff-note">Betöltés…</p>');
  if (cached && !cached.stale) return;
  SRC.diff(sha, fileEl.dataset.path).then(
    d => { diffCache.set(key, { data: d }); show(diffHtml(d)); },
    e => { if (!cached) show(`<p class="diff-note">A diff nem tölthető be: ${esc(
      (e && (e.message || e.code)) || e)}</p>`); });
}

/* Mindkét nézet elkészül (egymás alatti és side-by-side); hogy melyik látszik,
   azt a `.diff` szélessége dönti el egy container queryvel — átméretezéskor
   újrarenderelés nélkül vált. Hunkok közt a kihagyott sorok száma a régi oldal
   sorszámaiból jön. */
function diffHtml(d) {
  if (d.note) return `<p class="diff-note">${esc(d.note)}</p>`;
  if (d.binary) return '<p class="diff-note">Bináris fájl.</p>';
  if (!d.hunks.length) return '<p class="diff-note">Nincs megjeleníthető változás.</p>';
  let uni = '', split = '', oldEnd = 1;
  for (const h of d.hunks) {
    const gap = h.old - oldEnd;
    const gapHtml = gap > 0 ? `<p class="diff-gap">${gap} változatlan sor</p>` : '';
    uni += gapHtml + h.lines.map(l => `<div class="diff-line mono${KIND[l.t]}">`
      + diffCell(l, l.n) + '</div>').join('');
    split += gapHtml + splitRows(h);
    oldEnd = h.old + h.lines.filter(l => l.t !== '+').length;
  }
  return `<div class="diff-uni">${uni}</div><div class="diff-split">${split}</div>`
    + (d.truncated ? '<p class="diff-note">… a diff túl hosszú, a vége le van vágva.</p>' : '');
}

const KIND = { ' ': '', '+': ' add', '-': ' del' };
const diffCell = (l, no) => `<span class="no">${no}</span>`
  + `<span class="sg">${l.t === ' ' ? '' : l.t === '-' ? '−' : '+'}</span>`
  + `<span class="tx">${marked(l.s, l.hl)}</span>`;

/* Side-by-side: a változatlan sor mindkét oldalon (balra a régi sorszámmal), a
   törölt blokk és az utána jövő hozzáadott blokk sorai páronként egymás mellé —
   ugyanaz a párosítás, amiből a Python a szó-kiemelést számolja. */
function splitRows(h) {
  const L = h.lines, side = (l, no) => l
    ? `<div class="half${KIND[l.t]}">${diffCell(l, no)}</div>` : '<div class="half none"></div>';
  let out = '', old = h.old, i = 0;
  while (i < L.length) {
    if (L[i].t === ' ') {
      out += `<div class="split-row mono">${side(L[i], old)}${side(L[i], L[i].n)}</div>`;
      old++; i++;
      continue;
    }
    let j = i; while (j < L.length && L[j].t === '-') j++;
    let k = j; while (k < L.length && L[k].t === '+') k++;
    for (let r = 0; r < Math.max(j - i, k - j); r++) {
      const del = r < j - i ? L[i + r] : null, add = r < k - j ? L[j + r] : null;
      out += `<div class="split-row mono">${side(del, del && del.n)}${side(add, add && add.n)}</div>`;
    }
    old += j - i; i = k;
  }
  return out;
}

/* Az ablak (Artifact-panel) átméretezése sortörést és nézetváltást hozhat: a
   sorok Y-pozíciója elmozdul, a gráfnak követnie kell. */
new ResizeObserver(() => drawGraph()).observe(rowsEl);

const marked = (s, hl) => {
  if (!hl || !hl.length) return esc(s);
  let out = '', at = 0;
  for (const [a, b] of hl) { out += esc(s.slice(at, a)) + `<mark>${esc(s.slice(a, b))}</mark>`; at = b; }
  return out + esc(s.slice(at));
};

rowsEl.addEventListener('click', e => {
  if (e.target.closest('a[href]')) return;   // GitHub-link: nyíljon, a sor ne csukódjon
  const file = e.target.closest('.file');
  if (file) { toggleFile(file, expanded, file.getAttribute('aria-expanded') !== 'true'); return; }
  const jump = e.target.closest('[data-jump]');
  if (jump) {
    const target = rowsEl.querySelector(`.row[data-sha="${jump.dataset.jump}"]`);
    if (target) { open(jump.dataset.jump); target.scrollIntoView({ block: 'center' }); }
    return;
  }
  const row = e.target.closest('.row');
  if (!row) return;
  if (row.getAttribute('aria-expanded') === 'true') {
    row.setAttribute('aria-expanded', 'false');
    document.querySelectorAll('.details').forEach(d => d.remove());
    expanded = null;
    drawGraph();
  } else open(row.dataset.sha);
});

document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && expanded) {
    document.querySelectorAll('.details').forEach(d => d.remove());
    rowsEl.querySelectorAll('.row').forEach(r => r.setAttribute('aria-expanded', 'false'));
    expanded = null;
    drawGraph();
  }
});

/* ── Szűrők ──────────────────────────────────────────────────────────────── */
const branchSel = document.getElementById('branchSel');

/* A kiválasztott ágat megtartjuk, ha az adatcsere után is létezik. */
function fillBranches() {
  const keep = branchSel.value;
  branchSel.innerHTML = '<option value="">Minden ág</option>' +
    DATA.branches.map(b => `<option value="${esc(b.name)}"${b.current ? ' selected' : ''}>`
      + esc(b.name) + (b.track ? ` (${esc(b.track)})` : '') + '</option>').join('');
  branchSel.value = DATA.branches.some(b => b.name === keep) ? keep : '';
}

function ancestryOf(name) {
  const tip = DATA.commits.find(c => c.refs.some(r => r.name === name &&
    (r.kind === 'branch' || r.kind === 'head')));
  if (!tip) return null;
  const keep = new Set(), stack = [tip.sha];
  const bySha = new Map(DATA.commits.map(c => [c.sha, c]));
  while (stack.length) {
    const sha = stack.pop();
    if (keep.has(sha)) continue;
    keep.add(sha);
    (bySha.get(sha)?.parents || []).forEach(p => bySha.has(p) && stack.push(p));
  }
  return keep;
}

function applyFilters() {
  const branch = branchSel.value;
  const remotes = document.getElementById('showRemotes').checked;
  const refsOnly = document.getElementById('onlyRefs').checked;
  const keep = branch ? ancestryOf(branch) : null;

  visible = DATA.commits.filter(c => {
    if (c.uncommitted) return true;       // állapot, nem commit: mindig látszik
    if (keep && !keep.has(c.sha)) return false;
    if (refsOnly && c.refs.length === 0) return false;
    if (!remotes && c.refs.length && c.refs.every(r => r.kind === 'remote')) return false;
    return true;
  });
  render();
}
['branchSel', 'showRemotes', 'onlyRefs'].forEach(id =>
  document.getElementById(id).addEventListener('change', applyFilters));

/* ── Téma ────────────────────────────────────────────────────────────────── */
document.getElementById('themeBtn').addEventListener('click', () => {
  const root = document.documentElement;
  const dark = root.getAttribute('data-theme') === 'dark' ||
    (!root.hasAttribute('data-theme') && !matchMedia('(prefers-color-scheme: light)').matches);
  root.setAttribute('data-theme', dark ? 'light' : 'dark');
});

hydrate();
fillBranches();
render();

/* ── Élő frissítés ───────────────────────────────────────────────────────
   Két forrás, egy logika: a Browser panelen a helyi `gg --serve` (HTTP), az
   Artifactban a gépen futó `gg --mcp` (a Claude app host-hídján át). Az olcsó
   ujjlenyomatot pollozzuk, teljes adatot csak tényleges változásra kérünk: a
   lap helyben rajzol újra, a nyitott panel, a szűrők és a görgetés megmaradnak.
   A lábléc a mért időket is mutatja (ujjlenyomat · adat). */
const POLL_MS = 2000;
const foot = document.getElementById('foot');
const scroller = document.querySelector('.scroll');

function httpSource() {
  const get = path => fetch(path + location.search, { cache: 'no-store' }).then(r => r.json());
  const diff = (sha, path) => {
    const q = new URLSearchParams(location.search);
    q.set('sha', sha);
    q.set('path', path);
    return fetch('/diff?' + q, { cache: 'no-store' })
      .then(r => r.ok ? r.json() : r.text().then(t => { throw new Error(t.trim()); }));
  };
  return { fingerprint: () => get('/fingerprint'), data: () => get('/data'), diff,
           where: 'gg --serve' };
}

async function mcpSource() {
  const mcp = window.claude && await window.claude.use('mcp');
  if (!mcp) return null;
  const call = (tool, args) => mcp.callTool(MCP_SERVER, tool, { repo: SLUG, ...args },
    { cache: false }).then(r => r.payload);
  return { fingerprint: () => call('fingerprint'), data: () => call('graph_data'),
           diff: (sha, path) => call('file_diff', { sha, path }),
           where: 'a gépeden futó git-graph' };
}

/* Adat még nincs (MCP-lap induláskor): az üzenet a sorok helyére kerül. */
function notice(text, stale = false) {
  if (!DATA.commits.length) rowsEl.innerHTML = `<p class="empty">${esc(text)}</p>`;
  foot.className = stale ? 'foot stale' : 'foot';
  foot.textContent = text;
}

/* MCP-hibakód → teendő. A nem `retryable` hibák nem múlnak el maguktól:
   ott megáll a pollozás (újratöltés próbálja újra). */
function mcpProblem(e) {
  switch (e && e.code) {
    case 'server_not_connected':
      return 'A lap nem éri el a gépeden futó git-graph-ot. Élő adat csak a Claude appban, a saját '
        + 'gépeden jön — és ott is csak, ha az app configjában benne van (install.sh --live, majd az app újraindítása).';
    case 'not_in_manifest': case 'cancelled':
      return 'A git-graph szervert nem engedélyezted ehhez a laphoz — töltsd újra, és engedd meg.';
    case 'tool_error':
      return 'A git-graph hibát jelzett: ' + e.message;
    default:
      return 'A git-graph nem válaszol (' + ((e && e.code) || e) + ').';
  }
}

function startLive(src) {
  let last = MODE === 'http' ? null : '';   // http: a beágyazott adat friss
  let change = '';                          // az utolsó változás: mikor, mennyi idő alatt
  SRC = src;
  async function poll() {
    let wait = POLL_MS;
    try {
      const t0 = performance.now();
      const f = await src.fingerprint();
      const tf = performance.now() - t0;
      const key = JSON.stringify(f);
      if (last !== null && key !== last) {
        const t1 = performance.now();
        DATA = await src.data();
        const td = performance.now() - t1;
        for (const [k, v] of diffCache) if (k.startsWith('*uncommitted\n')) v.stale = true;
        const top = scroller.scrollTop;
        hydrate();
        fillBranches();
        applyFilters();
        scroller.scrollTop = top;
        change = ` · utolsó változás ${new Date().toLocaleTimeString()}: adat ${Math.round(td)} ms,`
          + ` kirajzolva ${Math.round(performance.now() - t1)} ms alatt`;
      }
      last = key;
      foot.className = 'foot';
      foot.textContent = `Élő · ${f.repoPath || src.where} · ${new Date().toLocaleTimeString()}`
        + ` · ujjlenyomat ${Math.round(tf)} ms` + change;
    } catch (e) {
      if (MODE === 'http') {
        notice('A gg szerver nem válaszol — a gráf befagyott (gg --serve).', true);
      } else {
        notice(mcpProblem(e), true);
        if (!(e && e.retryable)) return;        // magától nem javul: nincs több kör
        wait = Math.max(POLL_MS, (e && e.retryAfterMs) || 0) * 2;
      }
    }
    setTimeout(poll, wait);                     // a következő kör az előző után
  }
  poll();
}

if (MODE === 'http') startLive(httpSource());
if (MODE === 'mcp') {
  notice('Kapcsolódás a gépeden futó git-graph-hoz…');
  mcpSource().then(src => src ? startLive(src) : notice(
    'Ezt a lapot a Claude appban nyisd meg: az adatot élőben a gépeden futó git-graph adja, '
    + 'böngészőből és telefonról nem érhető el.', true));
}
</script>
"""


STATIC_FOOT = ("Statikus pillanatkép — a <code class=\"mono\">gg</code> generálta. Élő nézet: "
               "a Browser panel (<code class=\"mono\">gg --serve</code>) vagy az Artifact a Claude appban.")
LIVE_FOOT = "Élő — kapcsolódás…"


def embed(payload: dict) -> str:
    r"""A `<script>`-be ágyazható JSON.

    Egy commit-üzenetben előfordulhat `</script>` (láttuk: „JSON-LD
    </script>-escape") — az a script blokkot korán lezárja, és a maradék JSON
    szövegként ömlik a lapra. A `<\/` JSON-szinten ugyanaz a karakterlánc, a
    HTML-parszer viszont nem látja benne a záró taget. A sorelválasztók (U+2028,
    U+2029) ugyanezt a kárt tudják okozni régebbi JS-motorokon.
    """
    raw = json.dumps(payload, ensure_ascii=False)
    return (raw.replace("</", "<\\/")
               .replace("\u2028", "\\u2028")
               .replace("\u2029", "\\u2029"))


def build(payload: dict, title: str, mode: str = "static", slug: str = "") -> str:
    """A lap: `static` — beágyazott pillanatkép, `http` — a gg --serve élő lapja,
    `mcp` — az Artifact vékony lapja (üres váz; az adat a `gg --mcp`-ből jön)."""
    meta = payload["meta"]
    return (
        TEMPLATE.replace("__DATA__", embed(payload))
        .replace("__MODE__", mode)
        .replace("__SLUG__", slug)
        .replace("__FOOT__", STATIC_FOOT if mode == "static" else LIVE_FOOT)
        .replace("__REPO__", html.escape(meta["repo"]))
        .replace("__TITLE__", html.escape(title))
    )


def thin_payload() -> dict:
    """Az Artifact-lap üres váza — csak a repó neve; az adatot a lap kéri."""
    return {"commits": [], "edges": [], "stats": {}, "branches": [],
            "meta": {"repo": repo_name(), "repoUrl": "", "head": "", "totalCommits": 0,
                     "shown": 0, "dirty": 0, "generated": "", "worktrees": []}}


# ── Élő kiszolgálás ─────────────────────────────────────────────────────────

STATE_DIR = Path.home() / ".git-graph"
CURRENT = STATE_DIR / "current"        # a session-hook írja, a szerver olvassa
REPOS = STATE_DIR / "repos.json"       # slug → repó útvonal (a --launch-config írja)
NO_AUTO_PUBLISH = STATE_DIR / "no-auto-publish"   # ha létezik: a szerver nem publikál
DEFAULT_PORT = 7788
LAUNCH_NAME = "git-graph"              # a bejegyzés neve a .claude/launch.json-ben


def slug_for(repo: Path) -> str:
    """Hostnév-barát, stabil azonosító a repóhoz.

    A mappanév olvashatóvá teszi, az útvonal-hash pedig egyértelművé: két
    azonos nevű mappa (`~/a/app`, `~/b/app`) nem üthet össze.
    """
    base = re.sub(r"[^a-z0-9]+", "-", repo.name.lower()).strip("-") or "repo"
    return f"{base[:40]}-{hashlib.sha1(str(repo).encode()).hexdigest()[:6]}"


def register(repo: Path) -> str:
    """A repó felvétele a slug-regiszterbe; a slugot adja vissza."""
    slug = slug_for(repo)
    try:
        data = json.loads(REPOS.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        data = {}
    if data.get(slug) != str(repo):
        data[slug] = str(repo)
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        REPOS.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n",
                         encoding="utf-8")
    return slug


def repo_for_slug(slug: str) -> Path | None:
    try:
        data = json.loads(REPOS.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    path = data.get(slug)
    return Path(path) if path else None


# ── Publikálás ──────────────────────────────────────────────────────────────

def page_path(repo: Path) -> Path:
    """A `gg` statikus pillanatképe: `~/.git-graph/<slug>/index.html`.

    A projektmappán KÍVÜL — a repóban nincs mit ignorálni.
    """
    return STATE_DIR / slug_for(repo) / "index.html"


def artifact_path(repo: Path) -> Path:
    """Az Artifact vékony lapja: `~/.git-graph/<slug>/artifact.html`.

    Innen tölti fel a publikáló (a claude-folyamat ezt a mappát kapja
    munkakönyvtárnak — az Artifact csak onnan olvas).
    """
    return STATE_DIR / slug_for(repo) / "artifact.html"


def drop_legacy_out() -> None:
    """A régi, repón belüli kimenet (`<repó>/.git-graph/`) eltávolítása.

    Csak ha kizárólag a mi `index.html`-ünk van benne, és nem követett fájl —
    idegen tartalomhoz nem nyúlunk.
    """
    legacy = REPO / ".git-graph"
    if not legacy.is_dir():
        return
    files = list(legacy.iterdir())
    if {p.name for p in files} <= {"index.html"} and not any(
            is_tracked(p.relative_to(REPO)) for p in files):
        for p in files:
            p.unlink()
        legacy.rmdir()


def write_page(payload: dict, title: str) -> Path:
    page = page_path(REPO)
    page.parent.mkdir(parents=True, exist_ok=True)
    page.write_text(build(payload, title), encoding="utf-8")
    drop_legacy_out()
    return page


def prepare_publish() -> dict | None:
    """Az Artifact vékony lapja: kiírja, ha eltér a legutóbb publikálttól.

    Adat nincs benne — a lap a Claude appban a gép `gg --mcp`-jéből kéri —,
    így csak sablon- (kód-) vagy repónév-változáskor kell újra feltölteni.
    None, ha van már Artifact, és a lap hashe egyezik. Csak git-hívás és
    fájlírás — a lassú feltöltés (`publish_page`) külön, lock nélkül fut.
    """
    name = repo_name()
    title = f"{name} Git Graph"
    html_page = build(thin_payload(), title, mode="mcp", slug=register(REPO))
    # A capability-deklaráció is része a publikált lapnak: ha változik, újra kell.
    digest = hashlib.sha256((html_page + json.dumps(PUBLISH_CAPS)).encode()).hexdigest()
    url = config_get("artifact")
    if url and digest == config_get("artifactHash"):
        return None
    page = artifact_path(REPO)
    page.parent.mkdir(parents=True, exist_ok=True)
    page.write_text(html_page, encoding="utf-8")
    return {"page": page, "url": url, "title": title, "digest": digest, "name": name}


def finish_publish(job: dict, url: str) -> None:
    remember_artifact(url, job["digest"])


# A hideg, headless publikálás beállításai — mérve, docs/artifact-findings.md:
# ezzel 5,6–6,2 s a `Published`-ig (ha a modell nem olvas bele a fájlba: +3 s).
PUBLISH_MODEL = "claude-sonnet-5-5"
PUBLISH_ENV = {
    # `-p` módban az Artifact tool alapból KI van kapcsolva (sdk_default_off),
    # ez az opt-in. A Desktop sessionből indítva azért működött nélküle is,
    # mert onnan a CLAUDE_CODE_ENTRYPOINT=claude-desktop öröklődik — a launchd
    # szerver alatt nincs ilyen.
    "CLAUDE_CODE_ARTIFACT": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",   # claude.ai konnektorok nélkül
    "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
}
PUBLISH_TIMEOUT_S = 180
PUBLISH_PARALLEL = 3
GATE_POLL_S = 0.3        # az Artifact tool késve kapcsol be — ennyinként kérdezünk újra
GATE_TRIES = 30
# A lap ezen át éri el a gépen futó gg --mcp-t (enélkül use("mcp") null).
PUBLISH_CAPS = {"mcp": {"servers": [{"server": "host:git-graph",
                                     "tools": ["fingerprint", "graph_data", "file_diff"]}]}}


def claude_bin() -> str | None:
    """A `claude` CLI — a launchd agent minimális PATH-ján is (`~/.local/bin`)."""
    extra = [str(Path.home() / ".local" / "bin"), "/opt/homebrew/bin", "/usr/local/bin"]
    return shutil.which("claude", path=os.pathsep.join([os.environ.get("PATH", ""), *extra]))


def publish_page(page: Path, url: str, title: str) -> str:
    """A lap feltöltése egy hideg, headless `claude` folyamattal; az URL-t adja.

    Az Artifact API-t csak a modell éri el (nincs rá CLI-alparancs), ezért egy
    szűk promptú, karcsú `claude -p` fut:
    - `--strict-mcp-config` + `ENABLE_CLAUDEAI_MCP_SERVERS=false`: MCP-szerver
      nélkül (444 helyett ~30 tool), `--setting-sources project`: user-hookok
      és pluginok nélkül — így 0,3 s-nál indul.
    - Az Artifact tool egy org-policy lekérdezés után kapcsol be, sokszor csak
      az első init UTÁN. Ezért `--input-format stream-json`: ha az init-ben
      még nincs Artifact, a kört megszakítjuk (interrupt) és ugyanabban a
      folyamatban újrakérdezünk — új folyamattal a kapu újra zárva indulna.
    - Friss sessionből a publish csak `Artifact read` után megy át (különben
      elutasítja, mert „nem látta" az élő verziót) — ezért kéri a prompt előbb.
    - A `Published` tool-válasznál kilépünk: a modell záró szövege felesleges.
    """
    exe = claude_bin()
    if not exe:
        raise RuntimeError("nem található a claude CLI (~/.local/bin, /opt/homebrew/bin)")
    caps = json.dumps(PUBLISH_CAPS)
    if url:
        prompt = (f"Publish the local file {page} to the existing artifact {url}. Steps: "
                  f"1) call Artifact with action read and url {url}; 2) call Artifact publish "
                  f"with url {url}, file_path {page} and capabilities exactly {caps}. If a "
                  "publish is refused, follow the refusal's instructions. Do nothing else. "
                  "Reply with the URL only.")
    else:
        prompt = (f"Publish the local file {page} as a new artifact titled {title!r}, with icon "
                  f"\"branch\" and capabilities exactly {caps}. Do nothing else. "
                  "Reply with the URL only.")
    # A host:git-graph csak akkor deklarálható, ha a publikáló session is látja a
    # szervert — ezért kapja meg (a többi MCP nélkül).
    mcp = {"mcpServers": {MCP_NAME: {"command": "/usr/bin/python3",
                                     "args": [str(Path(__file__).resolve()), "--mcp"]}}}
    cmd = [exe, "-p", "--input-format", "stream-json", "--output-format", "stream-json",
           "--verbose", "--strict-mcp-config", "--mcp-config", json.dumps(mcp),
           "--setting-sources", "project",
           "--no-session-persistence", "--model", PUBLISH_MODEL, "--effort", "low",
           "--tools", "Artifact", "Read", "--allowedTools", "Artifact"]
    proc = subprocess.Popen(cmd, cwd=page.parent, env=dict(os.environ, **PUBLISH_ENV),
                            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, text=True, bufsize=1)
    lines: queue.Queue = queue.Queue()

    def pump() -> None:
        for line in proc.stdout:
            lines.put(line)
        lines.put(None)

    def send(event: dict) -> None:
        proc.stdin.write(json.dumps(event) + "\n")
        proc.stdin.flush()

    def ask() -> None:
        send({"type": "user", "message": {"role": "user", "content": prompt}})

    threading.Thread(target=pump, daemon=True).start()
    deadline = time.monotonic() + PUBLISH_TIMEOUT_S
    tries, gated = 1, False
    try:
        ask()
        while True:
            line = lines.get(timeout=max(0.1, deadline - time.monotonic()))
            if line is None:
                raise RuntimeError("a claude folyamat váratlanul kilépett")
            event = json.loads(line)
            kind = event.get("type")
            if kind == "system" and event.get("subtype") == "init" \
                    and "Artifact" not in event.get("tools", []):
                send({"type": "control_request", "request_id": uuid.uuid4().hex,
                      "request": {"subtype": "interrupt"}})
                gated = True
            elif kind == "result":
                if gated and tries < GATE_TRIES:
                    time.sleep(GATE_POLL_S)
                    tries, gated = tries + 1, False
                    ask()
                    continue
                reason = "az Artifact tool nem kapcsolt be" if gated else event.get("result", "")
                raise RuntimeError(f"nem publikált: {str(reason)[:300]}")
            message = event.get("message")
            blocks = message.get("content") if isinstance(message, dict) else None
            for block in blocks if isinstance(blocks, list) else []:
                if block.get("type") != "tool_result":
                    continue
                text = block.get("content")
                text = text if isinstance(text, str) else json.dumps(text)
                found = re.search(r"Published .+? at (https://claude\.ai/[^\s)\"]+)", text)
                if found:
                    return found.group(1)
    except queue.Empty:
        raise RuntimeError(f"időtúllépés ({PUBLISH_TIMEOUT_S} s)") from None
    except OSError as exc:                     # a folyamat közben kilépett (EPIPE)
        raise RuntimeError(f"a claude folyamat hibája: {exc}") from None
    finally:
        proc.kill()


def write_launch_config(repo: Path, port: int) -> tuple[Path, str]:
    """Az élő preview bejegyzése a repó `.claude/launch.json`-jába.

    A Claude Desktop localhostra CSAK origint fogad el — path és query nélkül
    (mérve: „a localhost address with a path or query"). A repót ezért a
    hostnév hordozza: `<slug>.localhost`, amit a panel Chromiumja a loopbackra
    old fel. A fájl többi bejegyzését és kulcsát nem bántjuk.
    """
    slug = register(repo)
    url = f"http://{slug}.localhost:{port}"
    path = repo / ".claude" / "launch.json"

    data: dict = {}
    if path.exists():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            raise SystemExit(f"HIBA: {path} nem érvényes JSON — kézzel kell javítani.")
        if not isinstance(data, dict):
            raise SystemExit(f"HIBA: {path} gyökere nem objektum.")

    data.setdefault("version", "0.0.1")
    others = [c for c in data.get("configurations", [])
              if not (isinstance(c, dict) and c.get("name") == LAUNCH_NAME)]
    # Mindig az ELSŐ bejegyzés: a névtelen indítás a lista elejéről választ.
    data["configurations"] = [{"name": LAUNCH_NAME, "url": url, "port": port}] + others

    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return path, url


def keep_launch_local(path: Path) -> bool:
    """A launch.json a repó lokális ignore-listájába, ha még nem követett fájl.

    A benne lévő slug az abszolút útvonalból származik — más gépen értelmetlen,
    tehát nem commitolandó. Ha a repó viszont MÁR követi a fájlt (van benne más
    dev-szerver bejegyzés), nem nyúlunk hozzá: az exclude ott úgysem hatna.
    """
    if is_tracked(path.relative_to(REPO)):
        return False
    return add_local_exclude(".claude/launch.json",
                             "gitgraph preview-bejegyzése (gépfüggő slug)")


def port_open(port: int) -> bool:
    """Fut-e már valami a loopback porton (a hook ebből tudja, van-e mit nyitni)."""
    with socket.socket() as s:
        s.settimeout(0.2)
        return s.connect_ex(("127.0.0.1", port)) == 0


def current_repo(fallback: Path | None) -> Path | None:
    """A kiszolgálandó repó: amit a hook utoljára beírt, különben a fallback."""
    try:
        marked = Path(CURRENT.read_text(encoding="utf-8").strip()).expanduser()
    except OSError:
        return fallback
    try:
        return resolve_repo(marked)
    except SystemExit:
        return fallback


def serve(port: int, fallback: Path | None, limit: int | None) -> int:
    """Loopback HTTP szerver: `/` friss HTML, `/data` friss adat, `/fingerprint` olcsó."""
    # A REPO modulszintű globális, a kérések viszont más-más repót kérhetnek —
    # a kiszolgálást ezért sorosítjuk. Egy kérés pár tized másodperc.
    lock = threading.Lock()

    def switch(wanted: str | None, slug: str | None) -> Path:
        """A kérés repója: a `?repo=` paraméter, különben amit a hook beírt.

        A paraméter azért kell, mert egyszerre több session (több Browser panel)
        kérdezi ugyanezt a szervert — egy globális „aktuális repó" ilyenkor
        véletlenszerűen váltogatna. Az URL-be sütve minden panel a sajátját látja.
        """
        global REPO, _REMOTES
        if wanted:
            try:
                repo = resolve_repo(Path(wanted).expanduser())
            except SystemExit as exc:     # a resolve_repo CLI-re van szabva
                raise FileNotFoundError(str(exc)) from None
        elif slug:
            repo = repo_for_slug(slug)
            if repo is None:
                raise FileNotFoundError(
                    f"ismeretlen repó-azonosító: {slug} — futtasd a repóban: gg --launch-config")
        else:
            repo = current_repo(fallback)
        if repo is None:
            raise FileNotFoundError("nincs kiszolgálható repó")
        REPO = repo
        _REMOTES = None
        return repo

    def watched_repos() -> list[Path]:
        """A figyelt repók: amit a dev szerver ismer — a regiszter és a hook repója.

        Mindegyiknek jár Artifact: ahol még nincs, az első publikálás létrehozza.
        """
        try:
            paths = set(json.loads(REPOS.read_text(encoding="utf-8")).values())
        except (OSError, json.JSONDecodeError, AttributeError):
            paths = set()
        marked = current_repo(None)
        if marked is not None:
            paths.add(str(marked))
        found: list[Path] = []
        for path in sorted(paths):
            try:
                with lock:
                    repo = switch(path, None)
                if repo not in found:
                    found.append(repo)
            except Exception:
                pass                              # eltűnt mappa, nem repó
        return found

    # Indításkor minden repó egyszerre esedékes — egy claude-folyamat ~270 MB.
    slots = threading.BoundedSemaphore(PUBLISH_PARALLEL)

    def run_publish(repo: Path, busy: set) -> None:
        try:
            with lock:
                switch(str(repo), None)
                job = prepare_publish()
            if job is None:
                return                            # a lap nem változott
            with slots:
                started = time.monotonic()
                url = publish_page(job["page"], job["url"], job["title"])
            with lock:
                switch(str(repo), None)
                finish_publish(job, url)
            print(f"[publish] {job['name']}: {time.monotonic() - started:.1f} s → {url}", flush=True)
        except Exception as exc:
            print(f"[publish] {repo}: HIBA — {exc}", flush=True)
        finally:
            busy.discard(repo)

    def ensure_artifacts() -> None:
        """Minden ismert repónak legyen naprakész (vékony) Artifactja.

        A lap adat nélküli sablon: csak kódfrissítéskor (akkor a szerver is
        újraindul) vagy új repó regisztrálásakor kell feltölteni. Ezért elég
        indításkor és a regiszter változásakor ellenőrizni — a lap hashe dönt.
        """
        if not claude_bin():
            print("  Artifact-publikálás: KI — nem található a claude CLI", flush=True)
            return
        if NO_AUTO_PUBLISH.exists():          # fejlesztés közben: csak kézi gg --publish
            print(f"  Artifact-publikálás: KI — {NO_AUTO_PUBLISH} létezik", flush=True)
            return
        busy: set = set()
        stamp: float | None = -1.0
        while True:
            try:
                mtime: float | None = REPOS.stat().st_mtime
            except OSError:
                mtime = None
            if mtime != stamp:
                stamp = mtime
                for repo in watched_repos():
                    if repo not in busy:
                        busy.add(repo)
                        threading.Thread(target=run_publish, args=(repo, busy),
                                         daemon=True).start()
            time.sleep(5)

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "gitgraph"

        def reply(self, code: int, body: bytes, ctype: str) -> None:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self) -> None:
            split = urllib.parse.urlsplit(self.path)
            route = split.path.rstrip("/") or "/"
            query = urllib.parse.parse_qs(split.query)
            wanted = query.get("repo", [None])[0]
            # `<slug>.localhost` — a launch.json csak origint enged localhostra,
            # így a repó a hostnévben utazik.
            host = self.headers.get("Host", "").split(":")[0].lower()
            slug = host[: -len(".localhost")] if host.endswith(".localhost") else None
            try:
                with lock:
                    repo = switch(wanted, slug)
                    if route == "/fingerprint":
                        return self.reply(200, json.dumps(fingerprint()).encode(),
                                          "application/json; charset=utf-8")
                    if route == "/diff":
                        diff = file_diff(query.get("sha", [""])[0], query.get("path", [""])[0])
                        return self.reply(200, json.dumps(diff, ensure_ascii=False).encode(),
                                          "application/json; charset=utf-8")
                    if route in ("/", "/index.html", "/data"):
                        payload = collect_payload(limit)
                        if not payload:
                            raise RuntimeError(f"nincs commit: {repo}")
                        if route == "/data":
                            body = json.dumps(payload, ensure_ascii=False).encode()
                            return self.reply(200, body, "application/json; charset=utf-8")
                        title = f"{payload['meta']['repo']} Git Graph"
                        body = build(payload, title, mode="http").encode()
                        return self.reply(200, body, "text/html; charset=utf-8")
                self.reply(404, b"nincs ilyen utvonal\n", "text/plain; charset=utf-8")
            except Exception as exc:                      # a lap ebből lesz "befagyott"
                self.reply(503, f"{type(exc).__name__}: {exc}\n".encode(),
                           "text/plain; charset=utf-8")

        def do_POST(self) -> None:
            """`/open?url=…`: a GitHub-link a rendszerböngészőben.

            A Browser panel a `target=_blank` linket a saját fülén nyitná meg.
            Csak GitHub-URL és csak a saját lapról (Origin = Host) — idegen oldal
            ne nyitogasson fület a loopback szerveren át.
            """
            split = urllib.parse.urlsplit(self.path)
            url = urllib.parse.parse_qs(split.query).get("url", [""])[0]
            origin = urllib.parse.urlsplit(self.headers.get("Origin", "")).netloc
            if (split.path != "/open" or origin != self.headers.get("Host")
                    or not url.startswith("https://github.com/")):
                return self.reply(403, b"tiltott\n", "text/plain; charset=utf-8")
            webbrowser.open(url)
            self.reply(204, b"", "text/plain; charset=utf-8")

        def log_message(self, *args) -> None:             # csendes napló
            pass

    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError as exc:
        raise SystemExit(f"HIBA: a {port} port nem nyitható meg ({exc.strerror}). "
                         "Fut már egy gg --serve? Másik portra: --port N")
    repo = current_repo(fallback)
    # flush: launchd alatt a napló különben a puffere miatt üresnek látszik.
    print(f"✓ gg --serve  http://127.0.0.1:{port}", flush=True)
    print(f"  repó: {repo or '(még nincs — a session-hook majd beírja)'}", flush=True)
    print(f"  váltás: {CURRENT}", flush=True)
    print("  Artifactok: indításkor és új repónál ellenőrizve (a lap élő — adat a gg --mcp-ből)",
          flush=True)
    threading.Thread(target=ensure_artifacts, daemon=True).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nLeállt.")
    return 0


# ── MCP szerver a Claude appnak (`gg --mcp`) ────────────────────────────────

MCP_NAME = "git-graph"        # a Claude app configjában ez a kulcs → a lapon host:git-graph
_REPO_ARG = {"type": "object", "required": ["repo"], "properties": {
    "repo": {"type": "string", "description": "a repó slugja (~/.git-graph/repos.json)"}}}
MCP_TOOLS = [
    {"name": "fingerprint", "inputSchema": _REPO_ARG, "annotations": {"readOnlyHint": True},
     "description": "Olcsó ujjlenyomat a repó állapotáról (refek, HEAD, munkakönyvtár) — "
                    "ha változott, kérd a graph_data-t."},
    {"name": "graph_data", "inputSchema": _REPO_ARG, "annotations": {"readOnlyHint": True},
     "description": "A commit-gráf teljes adata: commitok, élek, fájlstatisztika, ágak, meta."},
    {"name": "file_diff", "annotations": {"readOnlyHint": True},
     "inputSchema": {"type": "object", "required": ["repo", "sha", "path"], "properties": {
         **_REPO_ARG["properties"],
         "sha": {"type": "string", "description": "commit sha, vagy *uncommitted"},
         "path": {"type": "string", "description": "a fájl útja, ahogy a graph_data adja"}}},
     "description": "Egy fájl diffje egy commitban, hunkokra és sorokra bontva."},
]


def mcp_tool(name: str, args: dict, limit: int | None) -> dict:
    """Egy tool-hívás eredménye (MCP `tools/call`). A hiba is eredmény: `isError`."""
    global REPO, _REMOTES

    def text(value: object, error: bool = False) -> dict:
        body = value if error else json.dumps(value)       # a hiba sima szöveg
        return {"content": [{"type": "text", "text": body}], "isError": error}

    repo = repo_for_slug(str(args.get("repo", "")))
    if repo is None:
        return text(f"ismeretlen repó: {args.get('repo')!r} — futtasd benne: gg --launch-config", True)
    REPO, _REMOTES = repo, None
    try:
        if name == "fingerprint":
            refs, files = change_signals()
            return text({"refs": refs, "files": files})
        if name == "graph_data":
            return text(collect_payload(limit))
        if name == "file_diff":
            return text(file_diff(str(args.get("sha", "")), str(args.get("path", ""))))
    except (subprocess.CalledProcessError, OSError, ValueError) as exc:
        return text(f"git-hiba ({repo}): {exc}", True)
    return text(f"ismeretlen tool: {name}", True)


def mcp_serve(limit: int | None) -> int:
    """MCP szerver stdio-n — a Claude app indítja a configjából (install.sh --live).

    Az Artifact vékony lapja a Claude app host-hídján át ezt hívja: az olcsó
    `fingerprint`-et sűrűn, a `graph_data`-t csak változáskor. Stdlib JSON-RPC
    2.0, soronként egy üzenet; a stdout-ra csak protokoll mehet. Mindkét tool
    read-only-nak jelölt: így az app nem kér hívásonként megerősítést.
    """
    out = sys.stdout.buffer

    def send(message: dict) -> None:
        out.write(json.dumps(message).encode() + b"\n")   # ASCII: nem függ a locale-tól
        out.flush()

    for raw in sys.stdin.buffer:
        try:
            msg = json.loads(raw.decode("utf-8"))
        except ValueError:
            continue
        mid, method = msg.get("id"), msg.get("method")
        if mid is None:
            continue                               # értesítés, pl. notifications/initialized
        params = msg.get("params") or {}
        if method == "initialize":
            result: dict = {"protocolVersion": params.get("protocolVersion", "2025-06-18"),
                            "capabilities": {"tools": {}},
                            "serverInfo": {"name": MCP_NAME, "version": "1"}}
        elif method == "ping":
            result = {}
        elif method == "tools/list":
            result = {"tools": MCP_TOOLS}
        elif method == "tools/call":
            try:
                result = mcp_tool(params.get("name", ""), params.get("arguments") or {}, limit)
            except Exception as exc:               # a szerver éljen tovább
                result = {"content": [{"type": "text", "text": f"hiba: {exc}"}], "isError": True}
        else:
            send({"jsonrpc": "2.0", "id": mid,
                  "error": {"code": -32601, "message": f"ismeretlen metódus: {method}"}})
            continue
        send({"jsonrpc": "2.0", "id": mid, "result": result})
    return 0


def session_hook(port: int) -> int:
    """Claude Code SessionStart hook: eltárolja a session repóját.

    Ha fut a szerver, a visszaadott additionalContext megkéri a modellt, hogy
    nyissa meg a Browser panelt — így a gráf gépelés nélkül megjelenik.
    """
    try:
        payload = json.load(sys.stdin)
    except Exception:
        payload = {}
    start = Path(payload.get("cwd") or Path.cwd())
    try:
        repo = resolve_repo(start)
    except SystemExit:
        return 0                                   # nem repó: nincs mit mutatni
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    CURRENT.write_text(f"{repo}\n", encoding="utf-8")
    if not port_open(port):
        return 0                                   # nem fut a szerver: néma kilépés
    # Ugyanaz a cím, amit a launch config is használ (`<slug>.localhost`), hogy
    # a panel egy tabot lásson kétféle URL helyett.
    url = f"http://{register(repo)}.localhost:{port}"
    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": (
                    f"A git-graph élő commit-gráf ezen a címen szolgál ki: {url} "
                    f"(most a(z) {repo} repót mutatja, magától frissül).\n"
                    "A session elején nyisd meg EGYSZER a Browser panelen — "
                    "preview_start, url paraméterrel —, és ne írj róla üzenetet."
                ),
            }
        },
        sys.stdout,
    )
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Git Graph-szerű commit-gráf egyetlen HTML fájlba.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    ap.add_argument("repo", nargs="?", default=".",
                    help="a repó (bármelyik könyvtára); alap: az aktuális")
    ap.add_argument("--out", default=None,
                    help="kimeneti HTML (relatív út a CWD-hez); "
                         "alap: ~/.git-graph/<slug>/index.html")
    ap.add_argument("--limit", type=int, default=0,
                    help="max. commit (0 = a teljes history, ez az alap)")
    ap.add_argument("--title", default=None, help="oldalcím")
    ap.add_argument("--open", nargs="?", const="auto", default=None,
                    choices=["auto", "local", "artifact"], dest="open_mode",
                    help="megnyitás a BÖNGÉSZŐBEN: auto/local (alap) = a helyi "
                         "pillanatkép; artifact = a közzétett Artifact (az élő "
                         "adatot csak a Claude appban kapja — böngészőben nem; "
                         "a Claude Artifact-ablakát a /git-graph nyitja)")
    ap.add_argument("--set-artifact", metavar="URL", default=None,
                    help="a repóhoz tartozó Artifact URL kézi megjegyzése")
    ap.add_argument("--publish", action="store_true",
                    help="az Artifact vékony lapjának publikálása egy headless "
                         "claude-dal (meglévőt frissít, ha nincs, létrehozza; "
                         "változatlan lapnál nem tölt fel) — a /git-graph ezt hívja")
    ap.add_argument("--mcp", action="store_true",
                    help="MCP szerver stdio-n a Claude appnak (az app indítja a "
                         "configjából; az Artifact innen kapja az élő adatot)")
    ap.add_argument("--serve", action="store_true",
                    help="élő kiszolgálás loopbackon (a lap magától frissül); "
                         "a mutatott repót a --session-hook váltja. Közben a "
                         "regisztrált repók Artifactját változáskor újrapublikálja")
    ap.add_argument("--port", type=int, default=DEFAULT_PORT,
                    help=f"a --serve és a --session-hook portja (alap: {DEFAULT_PORT})")
    ap.add_argument("--launch-config", action="store_true", dest="launch_config",
                    help="a repó .claude/launch.json-jébe beírja az élő preview "
                         "bejegyzését (a Browser panel: preview_start git-graph); "
                         "`ggl` néven hívva ez a default")
    ap.add_argument("--session-hook", action="store_true", dest="session_hook",
                    help="Claude Code SessionStart hook: a session repóját beírja "
                         "a ~/.git-graph/current fájlba (stdin: a hook JSON-ja)")
    args = ap.parse_args()

    # A `ggl` névvel hívva a --launch-config a default (busybox-stílusú alias):
    # a többi kapcsoló ugyanúgy megy, pl. `ggl ~/masik-repo --port 7799`.
    if Path(sys.argv[0]).name == "ggl":
        args.launch_config = True

    global REPO

    if args.session_hook:
        return session_hook(args.port)

    if args.mcp:
        return mcp_serve(args.limit or None)

    if args.launch_config:
        repo = resolve_repo(Path(args.repo).expanduser().resolve())
        REPO = repo
        path, url = write_launch_config(repo, args.port)
        print(f"✓ {path}")
        print(f"  {LAUNCH_NAME} → {url}")
        if keep_launch_local(path):
            print("  (.claude/launch.json felvéve a .git/info/exclude-ba)")
        elif is_tracked(path.relative_to(REPO)):
            print("  FIGYELEM: ez a fájl követett — a benne lévő slug gépfüggő, "
                  "más gépen nem érvényes.")
        if not port_open(args.port):
            print(f"  FIGYELEM: a {args.port} porton nem fut szerver "
                  "(./install.sh --live vagy gg --serve)")
        print("  A Browser panel innen veszi a címet; a sessionöd hookja magától "
              "megnyittatja. Kézzel: illeszd be a fenti URL-t a panel címsorába.")
        return 0

    if args.serve:
        # Indulhat repón kívülről is (launchd a "/"-ból indítja) — a repót a
        # hook adja meg; a pozicionális argumentum csak tartalék.
        try:
            fallback = resolve_repo(Path(args.repo).expanduser().resolve())
        except SystemExit:
            fallback = None
        return serve(args.port, fallback, args.limit or None)

    REPO = resolve_repo(Path(args.repo).expanduser().resolve())

    if args.set_artifact:
        if not args.set_artifact.startswith("https://"):
            raise SystemExit("HIBA: az URL-nek https://-sel kell kezdődnie.")
        remember_artifact(args.set_artifact)
        register(REPO)
        print(f"✓ Artifact megjegyezve: {args.set_artifact}")
        print(f"  {repo_name()} @ {git('rev-parse', '--short', 'HEAD').strip()}")
        return 0

    limit = args.limit or None

    if args.publish:
        job = prepare_publish()
        if job is None:
            print(f"✓ Az Artifact naprakész, nincs mit feltölteni: {config_get('artifact')}")
            return 0
        started = time.monotonic()
        try:
            url = publish_page(job["page"], job["url"], job["title"])
        except RuntimeError as exc:
            raise SystemExit(f"HIBA: {exc}") from None
        finish_publish(job, url)
        print(f"✓ Artifact {'frissítve' if job['url'] else 'létrehozva'} "
              f"({time.monotonic() - started:.1f} s): {url}")
        print("  Élő: a Claude appban megnyitva a gépeden futó git-graph adja az adatot.")
        return 0

    payload = collect_payload(limit)
    if not payload:
        print("Nincs commit a repóban.", file=sys.stderr)
        return 1
    commits, edges = payload["commits"], payload["edges"]
    branches, meta = payload["branches"], payload["meta"]
    title = args.title or f"{meta['repo']} Git Graph"

    if args.out:
        out = Path(args.out).expanduser()
        if not out.is_absolute():
            out = Path.cwd() / out          # relatív út a hívás helyéhez
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(build(payload, title), encoding="utf-8")
        drop_legacy_out()
    else:
        out = write_page(payload, title)    # a repón kívül: ~/.git-graph/<slug>/

    print(f"✓ {out}  ({out.stat().st_size:,} B)")
    print(f"  {meta['repo']}: {len(commits)} commit"
          f"{'' if limit is None or len(commits) < limit else f' (a {limit}-es limitig)'}"
          f" · {max(c['lane'] for c in commits) + 1} sáv · {len(edges)} él"
          f" · {len(branches)} ág")

    url = config_get("artifact")
    if url:
        print(f"  Artifact (élő, a Claude appban): {url}")

    if args.open_mode:
        mode = args.open_mode
        if mode == "artifact" and not url:
            print("  Nincs megjegyzett Artifact ehhez a repóhoz — a helyi fájlt nyitom.")
            mode = "local"
        elif mode == "auto":
            # Böngészőben az Artifact nem kap élő adatot (az csak a Claude appban
            # megy) — ott a friss helyi pillanatkép a hasznos.
            mode = "local"
        webbrowser.open(url if mode == "artifact" else out.as_uri())
        where = "Artifact (böngészőben)" if mode == "artifact" else "helyi fájl"
        print(f"  Megnyitva: {where}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
